# Apenas credenciais locais de desenvolvimento. Nunca reutilize em produção.
POSTGRES_USER=condominios_dev
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=condominios
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Opcional: substitui os campos POSTGRES_* no backend. Use postgresql+psycopg://...
# DATABASE_URL=
APP_NAME=Gestão de Condomínios
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Portas publicadas apenas na máquina local.
API_PORT=8000
WEB_PORT=5173
# Endpoint da API local. O Compose troca o interno por http://storage:9000.
STORAGE_ENDPOINT=http://127.0.0.1:9000
# Endereço acessível ao navegador; precisa corresponder a STORAGE_PORT.
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Credenciais fictícias exclusivas do ambiente local (não reutilizar em produção).
STORAGE_ACCESS_KEY=condominios_storage_dev
STORAGE_SECRET_KEY=storage_local_dev_only
# Bucket privado e região usada na assinatura S3.
STORAGE_BUCKET=condominios-arquivos
STORAGE_REGION=us-east-1
# Validade da URL de download, de 1 a 300 segundos.
STORAGE_URL_SECONDS=60
# Contrato futuro de e-mail; ainda não consumido. Console não envia mensagens reais.
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=example_user
SMTP_PASSWORD=example_only
SMTP_FROM=nao-responda@example.test
SMTP_STARTTLS=false

# Ambiente: development, test ou production. Em production o segredo JWT padrão é proibido.
APP_ENV=development
# Segredo que assina os tokens (mínimo de 32 caracteres). Em produção gere um próprio, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Bloqueio do login: após N erros seguidos o e-mail fica bloqueado por M minutos.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
